# Absolute or relative path to a real "스토어분석양식(...).xlsx" file, used only by
# tests/workbook-parser.real-fixture.test.ts for manual verification against real data.
# Never commit an actual value here or check the file itself into git.
NAVERSTORE_FIXTURE_XLSX_PATH=

# Server-side only. Enables the optional "GPT 심층 분석" button in the reviews tab
# (src/app/api/review-insight/route.ts). When unset, that button shows an error and
# the rest of the dashboard works unaffected. Never expose this to the client.
OPENAI_API_KEY=
